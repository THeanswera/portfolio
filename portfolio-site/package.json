{
  "name": "portfolio-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Сайт-портфолио Григория Мельникова — верстка и разработка сайтов",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-og-images.mjs && node scripts/build-assets.mjs && node scripts/prerender.mjs && node scripts/generate-meta.mjs && node scripts/clean-dist.mjs",
    "preview": "vite preview",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:visual": "node scripts/audit-visual.mjs",
    "check:images": "node scripts/case-shots.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs src html,css,ts,tsx,mjs",
    "check:domains": "node scripts/check-domains.mjs",
    "check:header": "node scripts/check-header.mjs",
    "check:seo": "node scripts/check-seo.mjs dist",
    "check:a11y": "node scripts/audit-a11y.mjs",
    "perf": "node scripts/measure-performance.mjs",
    "check:demos": "node scripts/check-demo-notices.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "iconv-lite": "^0.7.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
