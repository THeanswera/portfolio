# rootlost.ru — портфолио. Конфигурация Apache (проверено: .htaccess в /sextant/
# обрабатывается, значит AllowOverride для каталога сайта включён).
#
# nginx стоит перед Apache, поэтому переменные HTTPS и SERVER_PORT здесь не
# отражают схему запроса: схему сообщает X-Forwarded-Proto. Проверено пробой на
# сервере 23.09.2026: по https приходит «https», по http — «http», других
# значений нет. Поэтому переход на https сравнивается строго с «http» — на
# защищённом соединении условие не сработает и цикл невозможен.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 0. Зеркала: http → https и www → без www ---
  # Первым делом, чтобы всё остальное уже работало на каноническом адресе:
  # иначе браузер получил бы цепочку из двух перенаправлений.
  # Только схема и хост меняются, путь и параметры сохраняются.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^(.*)$ https://rootlost.ru/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.rootlost\.ru$ [NC]
  RewriteRule ^(.*)$ https://rootlost.ru/$1 [R=301,L]

  # --- 1. Старые адреса кейсов: /case.html?work=<id> → /cases/<slug>/ ---
  # Карта точная: только известные работы. Неизвестный work не перенаправляем
  # «куда-нибудь» — он попадёт на страницу 404, потому что файла нет.
  RewriteCond %{QUERY_STRING} (^|&)work=sextant(&|$) [NC]
  RewriteRule ^case\.html$ /cases/sextant/? [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)work=forma(&|$) [NC]
  RewriteRule ^case\.html$ /cases/forma/? [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)work=kitstroy(&|$) [NC]
  RewriteRule ^case\.html$ /cases/kitstroy/? [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)work=technoremont(&|$) [NC]
  RewriteRule ^case\.html$ /cases/technoremont/? [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)work=sincere(&|$) [NC]
  RewriteRule ^case\.html$ /cases/sincere/? [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)work=sertexity(&|$) [NC]
  RewriteRule ^case\.html$ /cases/sertexity/? [R=301,L]

  # Старый общий адрес без параметра — в каталог кейсов.
  RewriteRule ^case\.html$ /cases/ [R=301,L]

  # --- 2. index.html приводим к адресу каталога ---
  # Правило не заходит в /sextant/ и /remont/: их страницы лежат в своих папках,
  # а RewriteRule без ведущего слэша работает только в текущем каталоге.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # --- 3. Путь без завершающего слэша у папки: /cases/sextant → /cases/sextant/ ---
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # --- 4. Адреса прежнего сайта на WordPress: страницы удалены навсегда ---
  # В поиске они ещё видны, поэтому отвечаем 410 Gone — это точнее, чем 404:
  # робот понимает, что документ не вернётся, и убирает его быстрее.
  # Перенаправлять их на главную нельзя: это разные темы, и такой переход
  # поисковики считают подменой.
  RewriteRule ^services(/.*)?$ - [G,L]
  RewriteRule ^20[0-9]{2}(/[0-9]{2})?(/.*)?$ - [G,L]
  RewriteRule ^(category|tag|author)(/.*)?$ - [G,L]
  RewriteRule ^(hello-world|sample-page)(/.*)?$ - [G,L]
  RewriteRule ^(wp-content|wp-includes|wp-json|wp-admin)(/.*)?$ - [G,L]
  # Точные адреса, а не префиксы: правило ^feed иначе задело бы, например, /feedback.
  RewriteRule ^wp-login\.php$ - [G,L]
  RewriteRule ^xmlrpc\.php$ - [G,L]
  RewriteRule ^feed/?$ - [G,L]
  RewriteRule ^comments/feed/?$ - [G,L]
  RewriteRule ^wp-sitemap.*$ - [G,L]
  RewriteRule ^sitemap_index\.xml$ - [G,L]
</IfModule>

# --- 5. Страницы ошибок ---
# Обе отдают нашу разметку: у 404 и 410 один смысл для посетителя —
# «здесь ничего нет, вот куда идти».
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# --- 6. Кеширование ---
<IfModule mod_headers.c>
  # HTML не кешируем надолго: после выкладки должна приезжать новая разметка,
  # а не ссылки на уже удалённые файлы сборки.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # У файлов сборки в имени хеш содержимого — их можно кешировать надолго.
  <FilesMatch "\.(js|css|woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=3888000"
  </FilesMatch>
</IfModule>

# --- 7. Зеркала ---
# Редиректы с http и с www включены в разделе 0. Заголовок X-Forwarded-Proto
# проверен пробой на сервере 23.09.2026: по https приходит «https», по http —
# «http». Живая проверка после включения: http://rootlost.ru/ → 301 на
# https://rootlost.ru/, https://www.rootlost.ru/ → 301 на https://rootlost.ru/,
# при этом https://rootlost.ru/ отвечает 200 и цепочки из двух переходов нет.
